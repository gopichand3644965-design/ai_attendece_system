packages:
  yum:
    mesa-libGL: []
    mesa-libGL-devel: []
    libglvnd-glx: []
    glib2: []
    glib2-devel: []
    libjpeg-turbo: []
    libpng: []
    libSM: []
    libXext: []
    libXrender: []
    gcc: []
    python3-devel: []

option_settings:
  # Environment variables
  aws:elasticbeanstalk:application:environment:
    FACE_MODEL: buffalo_s
    DET_SIZE: "320"
    OMP_NUM_THREADS: "1"
    OPENBLAS_NUM_THREADS: "1"
    MKL_NUM_THREADS: "1"
    MALLOC_ARENA_MAX: "2"
    PYTHONUNBUFFERED: "1"

  # Increase deployment timeout — model loading + pip install takes time
  aws:elasticbeanstalk:command:
    Timeout: "900"
    DeploymentPolicy: AllAtOnce

  # Health check path (works on single-instance)
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /ping

  # Use basic health reporting (more forgiving for single-instance)
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: basic
