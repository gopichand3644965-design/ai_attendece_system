packages:
  yum:
    mesa-libGL: []
    mesa-libGL-devel: []
    libglvnd-glx: []

option_settings:
  # Environment variables
  aws:elasticbeanstalk:application:environment:
    FACE_MODEL: buffalo_s
    DET_SIZE: "320"
    OMP_NUM_THREADS: "1"
    OPENBLAS_NUM_THREADS: "1"
    MKL_NUM_THREADS: "1"
    MALLOC_ARENA_MAX: "2"
    PYTHONUNBUFFERED: "1"

  # Increase deployment timeout — model loading + pip install takes time
  aws:elasticbeanstalk:command:
    Timeout: "900"

  # Health check path (works on single-instance)
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /ping
