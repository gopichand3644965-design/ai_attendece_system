packages:
  yum:
    mesa-libGL: []

commands:
  01_install_insightface:
    command: |
      source /var/app/venv/*/bin/activate
      pip install --no-cache-dir --no-deps insightface==2.0 onnx
    ignoreErrors: false

option_settings:
  aws:elasticbeanstalk:application:environment:
    FACE_MODEL: buffalo_s
    DET_SIZE: "320"
    OMP_NUM_THREADS: "1"
    OPENBLAS_NUM_THREADS: "1"
    MKL_NUM_THREADS: "1"
    MALLOC_ARENA_MAX: "2"
    PYTHONUNBUFFERED: "1"

  # Increase deployment timeout — first deploy loads the model which takes time
  aws:elasticbeanstalk:command:
    Timeout: "600"

  # Health check configuration
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /ping
    MatcherHTTPCode: "200"

  # Use Application Load Balancer
  aws:elasticbeanstalk:environment:
    LoadBalancerType: application

  # Sticky sessions for webcam streaming
  aws:elasticbeanstalk:environment:process:default:
    StickinessEnabled: true
    StickinessLBCookieDuration: "86400"
