packages:
  yum:
    mesa-libGL: []
    mesa-libGL-devel: []
    libglvnd-glx: []

option_settings:
  # Environment variables
  aws:elasticbeanstalk:application:environment:
    FACE_MODEL: buffalo_s
    DET_SIZE: "320"
    OMP_NUM_THREADS: "1"
    OPENBLAS_NUM_THREADS: "1"
    MKL_NUM_THREADS: "1"
    MALLOC_ARENA_MAX: "2"
    PYTHONUNBUFFERED: "1"

  # Increase deployment timeout — model loading + pip install takes time
  aws:elasticbeanstalk:command:
    Timeout: "900"
    DeploymentPolicy: Rolling

  # Health check configuration
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /ping
    MatcherHTTPCode: "200"
    HealthCheckInterval: "30"
    HealthCheckTimeout: "10"
    HealthyThresholdCount: "3"
    UnhealthyThresholdCount: "5"
    StickinessEnabled: true
    StickinessLBCookieDuration: "86400"

  # Use Application Load Balancer
  aws:elasticbeanstalk:environment:
    LoadBalancerType: application

  # Enhanced health reporting — gives better error messages
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
    EnhancedHealthAuthEnabled: true

  # Increase instance deployment timeout
  aws:autoscaling:updatepolicy:rollingupdate:
    RollingUpdateEnabled: true
    RollingUpdateType: Health
    MinInstancesInService: "0"
    MaxBatchSize: "1"
    PauseTime: PT10M
