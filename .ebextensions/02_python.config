option_settings:
  # Tell EB to use the Procfile instead of default WSGI (gunicorn/mod_wsgi)
  aws:elasticbeanstalk:container:python:
    WSGIPath: procfile

  # Stream logs in real-time for easier debugging
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: "7"
